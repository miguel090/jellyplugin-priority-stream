    <PackageReference Include="Moq" Version="4.18.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <!-- Tests run outside the server, so they need the Jellyfin assemblies at runtime. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jellyfin.Plugin.LiveTvPriority\Jellyfin.Plugin.LiveTvPriority.csproj" />
  </ItemGroup>

